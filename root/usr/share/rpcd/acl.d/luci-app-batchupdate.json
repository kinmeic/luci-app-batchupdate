{
	"luci-app-batchupdate": {
		"description": "Grant access to luci-app-batchupdate",
		"write": {
			"file": {
				"/usr/bin/batchupdate list": [ "exec" ],
				"/usr/bin/batchupdate status": [ "exec" ],
				"/usr/bin/batchupdate log": [ "exec" ],
				"/usr/bin/batchupdate update": [ "exec" ],
				"/usr/bin/batchupdate refresh": [ "exec" ],
				"/usr/bin/batchupdate start": [ "exec" ],
				"/usr/bin/batchupdate start *": [ "exec" ],
				"/usr/bin/batchupdate blacklist list": [ "exec" ],
				"/usr/bin/batchupdate blacklist add *": [ "exec" ],
				"/usr/bin/batchupdate blacklist del *": [ "exec" ]
			},
			"ubus": {
				"file": [ "exec" ]
			}
		}
	}
}
